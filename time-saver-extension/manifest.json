{
  "manifest_version": 3,
  "name": "Activity Tracker (console)",
  "version": "0.1.0",
  "permissions": ["tabs", "history", "webNavigation", "downloads", "sessions", "storage",
                  "idle", "bookmarks", "readingList", "tabGroups", "management"],
  "background": {
    "service_worker": "tracker.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
