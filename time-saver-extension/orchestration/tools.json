  {
    "type": "function",
    "name": "submitRecommendation",
    "description": "reshape the recommendations to submit to the backend logic",
    "parameters": {
      "type": "object",
      "properties": {
        "recommendations": {
          "$ref": "#/$defs/CatalogData"
        }
      },
      "required": [
        "recommendations"
      ],
      "additionalProperties": false,
      "$defs": {
        "CatalogData": {
          "type": "object",
          "properties": {
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CatalogEntry"
              }
            }
          },
          "required": [
            "entries"
          ],
          "additionalProperties": false
        },
        "CatalogEntry": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "$ref": "#/$defs/CatalogEntryType"
            },
            "name": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            },
            "needs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Need"
              }
            },
            "url": {
              "type": "string"
            },
            "shortcut": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            },
            "last_verified": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "id",
            "type",
            "name",
            "summary",
            "needs",
            "url",
            "shortcut",
            "last_verified"
          ],
          "additionalProperties": false
        },
        "CatalogEntryType": {
          "type": "string",
          "enum": [
            "chrome_feature",
            "extension"
          ]
        },
        "Need": {
          "type": "string",
          "enum": [
            "aller_retour",
            "copier_coller",
            "lecture_longue",
            "ouverture_quotidienne",
            "raccourcis_clavier",
            "traduction",
            "trop_onglets"
          ]
        }
      }
    },
    "strict": true
  },
  {
    "type": "function",
    "name": "sendPrettyRecommendation",
    "description": "send the data in a convienent way for UI. all fields are strings for AI to make\nSHORT sentences to display on screen as recommendations to the user",
    "parameters": {
      "type": "object",
      "properties": {
        "uirecommendationlist": {
          "$ref": "#/$defs/UIRecommendationList"
        }
      },
      "required": [
        "uirecommendationlist"
      ],
      "additionalProperties": false,
      "$defs": {
        "UIRecommendation": {
          "type": "object",
          "properties": {
            "behaviourPhrase": {
              "type": "string"
            },
            "needPhrase": {
              "type": "string"
            },
            "recommendationPhrases": {
              "type": "object",
              "properties": {
                "phrase": {
                  "type": "string"
                },
                "details": {
                  "type": "string"
                }
              },
              "required": [
                "phrase",
                "details"
              ],
              "additionalProperties": false
            },
            "urlForHelp": {
              "type": "string"
            }
          },
          "required": [
            "behaviourPhrase",
            "needPhrase",
            "recommendationPhrases",
            "urlForHelp"
          ],
          "additionalProperties": false
        },
        "UIRecommendationList": {
          "type": "object",
          "properties": {
            "uirecommendations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/UIRecommendation"
              }
            }
          },
          "required": [
            "uirecommendations"
          ],
          "additionalProperties": false
        }
      }
    },
    "strict": true
  }
