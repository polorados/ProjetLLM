{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["chrome", "node"],
    "skipLibCheck": true,
    "noEmit": true,
    "rewriteRelativeImportExtensions": true,
  },
  "include": ["**/*.ts", "orchestration/mini_tools.js"],
  "exclude": ["node_modules"]
}
