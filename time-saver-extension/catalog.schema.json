{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catalogue de recommandations",
  "type": "object",
  "required": ["schema_version", "version", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "version": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "entries": { "type": "array", "items": { "$ref": "#/definitions/entry" } }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "required": ["id", "type", "name", "summary", "needs", "url", "last_verified"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "type": { "enum": ["chrome_feature", "extension"] },
        "name": { "type": "string", "maxLength": 80 },
        "summary": { "type": "string", "maxLength": 160 },
        "needs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["trop_onglets", "aller_retour", "copier_coller", "ouverture_quotidienne", "traduction", "lecture_longue", "raccourcis_clavier"]
          }
        },
        "url": { "type": "string", "format": "uri" },
        "shortcut": { "type": "string", "maxLength": 80 },
        "extension_id": { "type": "string", "pattern": "^[a-p]{32}$" },
        "permissions_level": { "enum": ["low", "medium", "high"] },
        "last_verified": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}